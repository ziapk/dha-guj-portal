# Laravel API base URL. Server-side only: the browser never talks to Laravel directly.
API_URL=https://api.dhagrwproperties.com

# Optional: share the login cookie with the Public Web across subdomains, e.g. .example.com
SESSION_COOKIE_DOMAIN=

# Public Web base URL, used for "View on website" links (e.g. published projects).
NEXT_PUBLIC_WEB_URL=http://localhost:3002
